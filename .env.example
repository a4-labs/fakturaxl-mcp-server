# Port serwera HTTP MCP
PORT=3000

# Bazowy URL API FakturaXL (bez koncowego slasha)
FAKTURAXL_BASE_URL=https://program.fakturaxl.pl/api

# Timeout wywolan do FakturaXL w ms
FAKTURAXL_TIMEOUT_MS=30000

# Poziom logow: debug | info | warn | error
LOG_LEVEL=info

# Czy zapisywac logi wywolan API do plikow w katalogu logs/ (true/false)
LOG_TO_FILE=true

# Liczba zaufanych proxy przed aplikacja: 0 lokalnie, 1 za Traefikiem
TRUST_PROXY_HOPS=0

# --- OAuth 2.1 dla zdalnego MCP ---
# Druga metoda auth; legacy Authorization: Bearer <klucz FakturaXL> pozostaje aktywne.
OAUTH_ENABLED=false
# Publiczny origin bez sciezki. Na produkcji wymagany HTTPS.
PUBLIC_BASE_URL=http://localhost:3000
# Szyfrowany magazyn wielu grantow/kluczy. W Docker Compose nadpisany na /app/data/...
OAUTH_STORE_PATH=./data/oauth-store.json
# 32 losowe bajty zakodowane base64; wymagane tylko przy OAUTH_ENABLED=true.
OAUTH_STORE_KEY=
# Dodatkowe dokladne callbacki DCR; ChatGPT i Claude maja bezpieczne reguly wbudowane.
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:8787/callback,cursor://anysphere.cursor-mcp/oauth/callback,https://www.cursor.com/agents/mcp/oauth/callback
OAUTH_PENDING_TTL_MS=600000
OAUTH_CODE_TTL_MS=300000
# 0 = bezterminowo; uniewaznienie wymaga /revoke lub usuniecia magazynu.
OAUTH_ACCESS_TTL_MS=0
OAUTH_REFRESH_TTL_MS=0
OAUTH_AUTHORIZATION_ATTEMPTS=10
OAUTH_AUTHORIZATION_ATTEMPT_WINDOW_MS=900000

# --- Zapis (wystawianie faktur) ---
# Narzedzia zapisu (przygotuj_fakture / wystaw_fakture) sa domyslnie WYLACZONE.
# Bez tej flagi agent ich nie widzi i serwer dziala jak dotad, czyli read-only.
# Wystawienie faktury jest NIEODWRACALNE (ciagla numeracja) - wlaczaj swiadomie.
ALLOW_WRITE=false
# Waznosc tokenu podgladu z przygotuj_fakture (ms). Po tym czasie trzeba
# przygotowac dokument ponownie.
DRAFT_TTL_MS=600000

# --- Warstwa praktyczna (agent-friendly) ---
# Domyslna liczba wierszy zwracanych z list (reszta sygnalizowana przez has_more)
DEFAULT_LIST_LIMIT=50
# Twardy gorny limit wierszy zwracanych do agenta
MAX_LIST_LIMIT=500
# Maks. zakres dat dla auto-chunkingu (miesiace); powyzej -> przyciecie + ostrzezenie
MAX_RANGE_MONTHS=24
# TTL cache list slownikowych (klienci/produkty/magazyny/dzialy) w ms
CACHE_TTL_MS=300000
# Liczba wynikow na strone przy auto-paginacji (max FakturaXL = 500)
PAGE_SIZE=500
# Liczba prob przy kodzie 2 (rate limit) zanim zwrocimy blad
RATE_LIMIT_RETRIES=5
# Budzet czasu na jedno wywolanie narzedzia (ms). Po jego wyczerpaniu narzedzie
# zwraca dane czesciowe + kursor_nastepny. Musi byc mniejszy od timeoutu klienta MCP (zwykle 60s).
TOOL_BUDGET_MS=40000
# Maks. dlugosc body request/response w logach (pelne body tylko przy bledzie)
LOG_BODY_MAX_CHARS=2000
