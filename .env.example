# Port serwera HTTP MCP
PORT=3000

# Bazowy URL API FakturaXL (bez koncowego slasha)
FAKTURAXL_BASE_URL=https://program.fakturaxl.pl/api

# Timeout wywolan do FakturaXL w ms
FAKTURAXL_TIMEOUT_MS=30000

# Poziom logow: debug | info | warn | error
LOG_LEVEL=info

# Czy zapisywac logi wywolan API do plikow w katalogu logs/ (true/false)
LOG_TO_FILE=true

# --- Warstwa praktyczna (agent-friendly) ---
# Domyslna liczba wierszy zwracanych z list (reszta sygnalizowana przez has_more)
DEFAULT_LIST_LIMIT=50
# Twardy gorny limit wierszy zwracanych do agenta
MAX_LIST_LIMIT=500
# Maks. zakres dat dla auto-chunkingu (miesiace); powyzej -> przyciecie + ostrzezenie
MAX_RANGE_MONTHS=24
# TTL cache list slownikowych (klienci/produkty/magazyny/dzialy) w ms
CACHE_TTL_MS=300000
# Liczba wynikow na strone przy auto-paginacji (max FakturaXL = 500)
PAGE_SIZE=500
# Liczba prob przy kodzie 2 (rate limit) zanim zwrocimy blad
RATE_LIMIT_RETRIES=5
