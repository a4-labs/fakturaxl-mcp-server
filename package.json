{
  "name": "fakturaxl-mcp-server",
  "version": "1.0.0",
  "description": "Zdalny, read-only serwer MCP dla API FakturaXL (Streamable HTTP)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
